{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(.venv/bin/ruff check:*)",
      "Bash(python tools/check_docstrings.py:*)",
      "Bash(python3 tools/check_docstrings.py:*)",
      "Bash(.venv/bin/python tools/check_docstrings.py:*)",
      "Bash(.venv/bin/python docs/examples/build_demo.py:*)",
      "Bash(.venv/bin/lw --help)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git describe:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_service.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint_edited.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
